@{
    ViewData["Title"] = "Food Delivery App - Portals";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <style>
        /* Animated gradient background for header */
        .animated-header {
            background: linear-gradient(-45deg, #ff6f61, #ff9f80, #28a745, #007bff);
            background-size: 400% 400%;
            animation: gradientShift 12s ease infinite;
            position: relative;
            color: white;
            text-align: center;
            padding: 120px 20px; /* extra height for sliding h1 */
            overflow: hidden;
        }

        @@keyframes gradientShift {
            0% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }

            100% {
                background-position: 0% 50%;
            }
        }

        /* Sliding animation for h1 + icon */
        .sliding-header {
            position: absolute;
            top: 50%;
            left: -20%; /* start off-screen */
            transform: translateY(-50%);
            font-size: 2.8rem;
            font-weight: bold;
            white-space: nowrap; /* prevent wrapping */
            display: flex;
            align-items: center;
            gap: 10px; /* space between icon and text */
            animation: slideRight 15s linear infinite;
        }

        @@keyframes slideRight {
            0% {
                left: -20%;
            }

            100% {
                left: 100%;
            }
            /* move completely off right */
        }

        header p {
            position: relative;
            font-size: 1.2rem;
            margin-top: 140px; /* space below sliding header */
        }
    </style>
</head>
<body class="bg-light">
    <!-- Animated Gradient Header -->
    <header class="animated-header">
        <div class="sliding-header">
            <i class="fa-solid fa-bicycle"></i> <!-- delivery icon -->
            <h1>🍴 We Deliver Your Food To You!!!!! </h1>
        </div>

    </header>

    <div class="container my-5">
        <div class="row g-4">
            <!-- Customer Portal -->
            <div class="col-md-3">
                <div class="card shadow h-100 text-center p-3">
                    <i class="fa-solid fa-utensils fa-4x text-success mb-3"></i>
                    <div class="card-body">
                        <h5 class="card-title">Customer Portal</h5>
                        <p class="card-text">Browse restaurants, order food, and track deliveries.</p>
                        <a href="/Customer/Index" class="btn btn-success">Enter</a>
                    </div>
                </div>
            </div>

            <!-- Restaurant Owner Portal -->
            <div class="col-md-3">
                <div class="card shadow h-100 text-center p-3">
                    <i class="fa-solid fa-store fa-4x text-warning mb-3"></i>
                    <div class="card-body">
                        <h5 class="card-title">Restaurant Owner Portal</h5>
                        <p class="card-text">Manage your restaurant, menus, and incoming orders.</p>
                        <a href="/Restaurant/Index" class="btn btn-warning">Enter</a>
                    </div>
                </div>
            </div>

            <!-- Admin Portal -->
            <div class="col-md-3">
                <div class="card shadow h-100 text-center p-3">
                    <i class="fa-solid fa-user-shield fa-4x text-primary mb-3"></i>
                    <div class="card-body">
                        <h5 class="card-title">Admin Portal</h5>
                        <p class="card-text">Oversee the platform, manage users, and review reports.</p>
                        <a href="/Admin/Index" class="btn btn-primary">Enter</a>
                    </div>
                </div>
            </div>

            <!-- Delivery Portal -->
            <div class="col-md-3">
                <div class="card shadow h-100 text-center p-3">
                    <i class="fa-solid fa-motorcycle fa-4x text-danger mb-3"></i>
                    <div class="card-body">
                        <h5 class="card-title">Delivery Portal</h5>
                        <p class="card-text">View assigned deliveries and update delivery status.</p>
                        <a href="/Delivery/Index" class="btn btn-danger">Enter</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
